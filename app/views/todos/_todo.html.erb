<div id="<%= dom_id(todo) %>">
  <%= odt_card(
    variant: :elevated,
    radius: :"3xl",
    class: "p-6 transition-all duration-200 #{'opacity-80' if todo.completed?}"
  ) do %>
    <div class="space-y-3">
      <!-- Title & Category Badge Header -->
      <div class="flex items-start justify-between gap-4">
        <div>
          <%= odt_heading(
            todo.title,
            as: :h3,
            size: :lg,
            weight: :bold,
            class: (todo.completed? ? "line-through text-fg-muted" : "text-fg-strong")
          ) %>

          <% if todo.due_date.present? %>
            <%= odt_text(
              todo.due_date.strftime("%B %d, %Y"),
              size: :sm,
              color: :muted,
              class: "mt-1 block"
            ) %>
          <% end %>
        </div>

        <div>
          <% if todo.completed? %>
            <%= odt_badge(
              "✓ Completed",
              variant: :subtle,
              color: :success,
              radius: :full,
              class: "font-semibold text-xs px-3 py-1"
            ) %>
          <% else %>
            <% badge_color = case todo.category
               when "Shopping" then :info
               when "Personal" then :secondary
               else :primary
               end %>
            <%= odt_badge(
              todo.category.presence || "Task",
              variant: :subtle,
              color: badge_color,
              radius: :full,
              class: "font-semibold text-xs px-3 py-1"
            ) %>
          <% end %>
        </div>
      </div>

      <!-- Description -->
      <% if todo.description.present? %>
        <div class="pt-1">
          <%= odt_text(
            todo.description,
            size: :sm,
            color: (todo.completed? ? :muted : :default),
            class: "leading-relaxed"
          ) %>
        </div>
      <% end %>

      <!-- Action Buttons Row -->
      <div class="flex items-center gap-3 pt-2">
        <% if todo.completed? %>
          <%= link_to toggle_todo_path(todo), data: { turbo_method: :patch }, class: "inline-block no-underline" do %>
            <%= odt_button(
              "Reopen",
              variant: :ghost,
              color: :primary,
              size: :sm,
              class: "font-semibold underline hover:no-underline"
            ) %>
          <% end %>
        <% else %>
          <%= link_to toggle_todo_path(todo), data: { turbo_method: :patch }, class: "inline-block no-underline" do %>
            <%= odt_button(
              "Mark Complete",
              variant: :filled,
              color: :primary,
              size: :sm,
              radius: :full,
              class: "px-4 font-semibold"
            ) %>
          <% end %>
        <% end %>

        <%= link_to todo_path(todo), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this task?" }, class: "inline-block no-underline" do %>
          <%= odt_button(
            "Delete",
            variant: :ghost,
            color: :muted,
            size: :sm,
            class: "hover:text-danger text-fg-muted font-medium"
          ) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
