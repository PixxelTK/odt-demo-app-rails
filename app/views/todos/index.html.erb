<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
  <div class="lg:col-span-7 space-y-6">
    <%= render "stats" %>

    <div class="flex items-center gap-2">
      <%= odt_button "All Tasks (#{@total_count})",
        href: root_path(filter: "all"),
        variant: :capsule,
        color: (@filter == "all" ? :primary : :surface),
        size: :sm %>

      <%= odt_button "Active (#{@active_count})",
        href: root_path(filter: "active"),
        variant: :capsule,
        color: (@filter == "active" ? :primary : :surface),
        size: :sm %>

      <%= odt_button "Completed (#{@completed_count})",
        href: root_path(filter: "completed"),
        variant: :capsule,
        color: (@filter == "completed" ? :primary : :surface),
        size: :sm %>
    </div>

    <div id="todos_list" class="space-y-4">
      <% if @todos.any? %>
        <%= render @todos %>
      <% else %>
        <%= odt_card(variant: :subtle, radius: :"3xl", class: "p-8 text-center") do %>
          <%= odt_text "No tasks found in this view.", color: :muted %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="lg:col-span-5 space-y-6">
    <%= render "user_profile" %>
    <%= render "workspace_summary" %>
    <%= render "form_card" %>
  </div>
  <%= odt_button "Toaster!",
    variant: :capsule,
    color: :surface,
    class: "w-32",
    data: {
      odt_toast_title: "Toaster!",
      odt_toast_message: "The delicious toast is here.",
      odt_toast_type: "success"
    } %>
</div>
