<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "ODT UI Rails Showcase" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Tailwind CSS -->
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <!-- ODT UI Standalone Stylesheet -->
    <%= stylesheet_link_tag "odt_ui", "data-turbo-track": "reload" %>

    <!-- JavaScript & Stimulus -->
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full bg-surface-muted antialiased p-4 sm:p-8 text-fg">
    <%= odt_toaster position: :top_right do %>
      <%= odt_flash_toasts %>
    <% end %>

    <div class="max-w-5xl mx-auto space-y-6">
      <main>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
